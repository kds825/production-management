# Per-worktree env — copy to .env.worktree (gitignored) in each worktree.
# Rev 3 (Path D — Supabase-native): all worktrees share the Supabase DB declared in
# backend/.env's DATABASE_URL. This file only carries local port + LLM provider overrides.

BACKEND_PORT=8000   # main: 8000, track_a: 8001, track_b: 8002
FRONTEND_PORT=3000  # main: 3000, track_a: 3001, track_b: 3002

# LLM provider for the narrator (services/llm_explainer.py).
# - template: deterministic fallback, no external API calls. Default for parity + CI.
# - anthropic: live calls to Anthropic API (requires ANTHROPIC_API_KEY in backend/.env).
LLM_PROVIDER=template
